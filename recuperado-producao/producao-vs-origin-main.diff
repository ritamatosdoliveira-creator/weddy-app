> const COMPARE_HIDE_BY_CAT = { convites: ['hours', 'travel'], vestuario: ['hours', 'travel'], decoracao: ['hours'] };
> const COMPARE_PRIORITY_KEYS = ['price_low', 'more_services', 'longer_duration', 'flexibility', 'payment_terms', 'fewer_extra_costs'];
