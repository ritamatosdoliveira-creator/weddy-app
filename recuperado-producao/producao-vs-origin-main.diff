>     excludedIds: items.filter((i) => !i.has).map((i) => i.id),
>   };
>   if (priced.length < 2) return out;
>   if (priced.some((i) => i.unit)) { out.reason = 'unit_based'; return out; }
>   if (priced.some((i) => i.amount === null)) { out.reason = 'unparsable'; return out; }
