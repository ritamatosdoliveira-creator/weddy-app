rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Weddy Memories — fotos partilhadas pelos convidados (rsvp.html) ou pela
    // página pública (memorias.html, token "publico").
    // Leitura: só o casal (dono deste casamento). Escrita sem login, mas
    // (Out 2026) o weddingId e o token têm de corresponder a um convidado
    // real (documento guests/{token} com esse weddingId) — antes qualquer
    // pessoa podia criar ficheiros em caminhos inventados.
    match /memories/{weddingId}/{token}/{fileName} {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in
           firestore.get(/databases/(default)/documents/weddings/$(weddingId)).data.ownerEmails;
      allow create: if request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|heic|heif|gif)')
        && (token == 'publico'
            ? firestore.exists(/databases/(default)/documents/weddings/$(weddingId))
            : firestore.get(/databases/(default)/documents/guests/$(token)).data.weddingId == weddingId);
      allow delete: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in
           firestore.get(/databases/(default)/documents/weddings/$(weddingId)).data.ownerEmails;
      allow update: if false;
    }

    // Imagens do RASCUNHO do site (editor). Só o casal as lê (dentro da app,
    // via URL de download) e só o casal as cria: jpeg/png/webp até 5 MB, com
    // Premium ativo E dentro da validade (premiumUntil).
    // ATENÇÃO: um URL de download COM token ignora estas regras. Por isso, quando
    // o Premium acaba, o servidor muda os tokens das fotos (siteRotatePhotoTokens)
    // — os URLs antigos deixam de funcionar sem apagar nenhuma foto.
    // Sem SVG nem HEIC (SVG pode conter scripts). Estes URLs nunca vão para a
    // página pública: ao publicar, o servidor copia as fotos para public-sites/.
    match /sites/{weddingId}/{fileName} {
      allow read, delete: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in
           firestore.get(/databases/(default)/documents/weddings/$(weddingId)).data.ownerEmails;
      // Carregar/substituir: dono + Premium ativo + dentro da validade. As duas
      // consultas ao Firestore ficam numa função com "let" (uma chamada por
      // documento): o Storage limita as consultas ao Firestore por pedido.
      allow create, update: if canWriteSitePhoto(weddingId);
    }
    function canWriteSitePhoto(weddingId) {
      let w = firestore.get(/databases/(default)/documents/weddings/$(weddingId)).data;
      let s = firestore.get(/databases/(default)/documents/weddingSites/$(weddingId)).data;
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in w.ownerEmails
        && w.subscription.active == true
        && s.premiumUntil > request.time
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Fotos PÚBLICAS do site (cópias feitas pelo servidor). Só se podem ler
    // sem login enquanto o site estiver publicado e dentro da validade;
    // despublicado, suspenso ou expirado -> negado (sem listar, sem escrever).
    match /public-sites/{slug}/{fileName} {
      allow get: if publicSiteOpen(slug);
      allow list, write: if false;
    }

    function publicSiteOpen(slug) {
      let p = firestore.get(/databases/(default)/documents/publicWeddingSites/$(slug)).data;
      return p.status == 'published' && p.validUntil > request.time;
    }

    // Documentos do casamento (contratos, anexos) — só o casal dono.
    match /documents/{weddingId}/{fileName} {
      allow read, delete: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in
           firestore.get(/databases/(default)/documents/weddings/$(weddingId)).data.ownerEmails;
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in
           firestore.get(/databases/(default)/documents/weddings/$(weddingId)).data.ownerEmails
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/(jpeg|jpg|png|webp|heic|heif|gif)'));
    }

    // Capturas de ecrã do "Reportar problema" (index.html). Em falta até
    // Out 2026: sem esta regra, TODOS os uploads eram recusados e as
    // imagens perdiam-se em silêncio. Só o casal dono carrega; ninguém lê
    // pelo cliente (a equipa vê pela consola / Admin SDK).
    match /feedback/{weddingId}/{feedbackId}/{fileName} {
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in
           firestore.get(/databases/(default)/documents/weddings/$(weddingId)).data.ownerEmails
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|heic|heif|gif)');
      allow read, update, delete: if false;
    }
  }
}
