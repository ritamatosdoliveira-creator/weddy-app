{
  "name": "weddy-tests",
  "private": true,
  "description": "Testes automáticos da Weddy (locais; emuladores; sem serviços de produção).",
  "scripts": {
    "test": "node run-all.js",
    "test:unit": "node run-all.js --only unit",
    "test:functions": "node run-all.js --only consent,migrate,contact,notify,backfill,validate",
    "test:rules": "node run-all.js --only rules",
    "test:ui": "node run-all.js --only ui"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.0",
    "firebase": "^10.14.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "firebase-tools": "^13.0.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "nodemailer": "^6.10.1",
    "playwright": "^1.45.0"
  }
}
